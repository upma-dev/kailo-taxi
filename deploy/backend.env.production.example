# Kailo Taxi: Backend/.env for the VPS.  Copy to Backend/.env on the server and fill every empty value.
# Replace YOUR_DOMAIN with your real domain. Never commit the filled file.

# ===== SERVER =====
PORT=5000
NODE_ENV=production

# ===== DATABASE =====
MONGODB_URI=
MONGODB_DB_NAME=

# ===== JWT (use long random strings: openssl rand -hex 48) =====
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

# ===== FRONTEND / CORS (single domain, no trailing slash) =====
FRONTEND_URL=https://YOUR_DOMAIN
SOCKET_CORS_ORIGIN=https://YOUR_DOMAIN

# ===== SOCKET.IO standalone process (pm2: kailo-taxi-socket) =====
# The API reaches the socket server through Redis, so these three go together.
SOCKET_STANDALONE=true
SOCKET_PORT=5001
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_ENABLED=true

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=3500
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30

# ===== IMAGES: stored on the VPS disk, served by Nginx at /uploads/ =====
# Uploads are resized and converted to WebP by sharp (libvips) before they are saved.
# While UPLOAD_STORAGE_ROOT is set, Cloudinary is NOT used (leave its keys empty).
UPLOAD_STORAGE_ROOT=/var/www/uploads
UPLOAD_BASE_URL=https://YOUR_DOMAIN/uploads
UPLOAD_MAX_FILE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kailo-taxi

# ===== EMAIL (Gmail needs an App Password, not the normal password) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Kailo Taxi <noreply@YOUR_DOMAIN>"

# ===== GOOGLE MAPS =====
GOOGLE_MAPS_API_KEY=

# ===== ADMIN =====
ADMIN_REGISTRATION_CODE=
ADMIN_NOTIFICATION_EMAILS=

# ===== RAZORPAY =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== PASSWORD RESET / OTP =====
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
USE_DEFAULT_OTP=false
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
OTP_EXPIRY=5m

# ===== SMS INDIA HUB =====
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_PE_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=

# ===== FIREBASE (project kailo-f2084) =====
# Server key: easiest on a VPS is to upload the downloaded service-account JSON to
#   Backend/config/firebase-service-account.json   (this path is git-ignored)
# and leave FIREBASE_SERVICE_ACCOUNT empty. Or paste the whole JSON on one line into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=kailo-f2084
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@kailo-f2084.iam.gserviceaccount.com

